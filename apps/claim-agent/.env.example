# Populate apps/claim-agent/.env.local via:
#     ./scripts/fetch_env.sh claim-agent
#
# Mirrors `local.claim_secrets` + `module "claim_agent".env_vars` in
# infra/terraform/main.tf.

# ---- Secret Manager values ----
MONGODB_URI=
ANTHROPIC_API_KEY=
ELASTIC_URL=
ELASTIC_API_KEY=
PHOENIX_API_KEY=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# ---- Static ----
GCP_PROJECT_ID=claimit-beta
GOOGLE_CLOUD_PROJECT=claimit-beta
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_GENAI_USE_VERTEXAI=true
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/claimitbeta
PHOENIX_PROJECT_NAME=claimit
CLAIMIT_BCC_EMAIL=claimitbeta@gmail.com
PUBSUB_AUTH_DISABLED=1

# Optional tuning.
# AUTO_SEND_DELAY_SECONDS=300
# AUTO_SEND_BATCH_SIZE=50
