# Populate apps/assistant-agent/.env.local via:
#     ./scripts/fetch_env.sh assistant-agent
#
# Mirrors `local.assistant_secrets` + `module "assistant_agent".env_vars`
# in infra/terraform/main.tf.

# ---- Secret Manager values ----
MONGODB_URI=
ANTHROPIC_API_KEY=
ELASTIC_URL=
ELASTIC_API_KEY=
PHOENIX_API_KEY=

# ---- Static ----
GCP_PROJECT_ID=claimit-beta
GOOGLE_CLOUD_PROJECT=claimit-beta
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_GENAI_USE_VERTEXAI=true
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/claimitbeta
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/claimitbeta/v1/traces
PHOENIX_PROJECT_NAME=claimit
# Phoenix MCP Cloud Run bridge URL (injected at deploy; Mode B's
# read_claim_reasoning_spans reads claim traces through it). Leave blank locally
# to fall back to the stdio `npx @arizeai/phoenix-mcp` transport.
PHOENIX_MCP_URL=
GATEWAY_SA_EMAIL=claimit-api-gateway@claimit-beta.iam.gserviceaccount.com
PUBSUB_AUTH_DISABLED=1
