# Populate apps/ingest-agent/.env.local via:
#     ./scripts/fetch_env.sh ingest-agent
#
# Mirrors `local.ingest_secrets` + `module "ingest_agent".env_vars` in
# infra/terraform/main.tf.

# ---- Secret Manager values ----
MONGODB_URI=
SCRAPERAPI_KEY=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
SENDGRID_API_KEY=

# ---- Static ----
FRONTEND_BASE_URL=http://localhost:3000
GCP_PROJECT_ID=claimit-beta
GOOGLE_CLOUD_PROJECT=claimit-beta
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_GENAI_USE_VERTEXAI=true
RECEIPTS_BUCKET=claimit-beta-receipts
GMAIL_INBOUND_TOPIC=projects/claimit-beta/topics/gmail-inbound
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/claimitbeta
PHOENIX_PROJECT_NAME=claimit
# Bypass Pub/Sub OIDC checks when running locally (no inbound push tokens).
PUBSUB_AUTH_DISABLED=1
