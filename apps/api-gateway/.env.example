# Populate apps/api-gateway/.env.local via:
#     ./scripts/fetch_env.sh api-gateway
#
# Mirrors `local.api_gateway_secrets` + `module "api_gateway".env_vars` in
# infra/terraform/main.tf — keep in lockstep if Terraform changes.

# ---- Secret Manager values (loud values; never commit real ones) ----
MONGODB_URI=
ELASTIC_URL=
ELASTIC_API_KEY=
PHOENIX_API_KEY=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
STATE_JWT_SECRET=
CLAIMIT_INGEST_AGENT_ID=
CLAIMIT_MONITOR_AGENT_ID=
CLAIMIT_CLAIM_AGENT_ID=
CLAIMIT_ASSISTANT_AGENT_ID=

# ---- Static (safe to commit; mirrored from Terraform) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_REGEX=
FRONTEND_BASE_URL=http://localhost:3000
GCP_PROJECT_ID=claimit-beta
GOOGLE_CLOUD_PROJECT=claimit-beta
GOOGLE_CLOUD_LOCATION=us-east1
RECEIPTS_BUCKET=claimit-beta-receipts
EVIDENCE_BUCKET=claimit-beta-evidence
GMAIL_INBOUND_TOPIC=projects/claimit-beta/topics/gmail-inbound
# Gmail OAuth redirect is the deployed Cloud Run callback — Gmail won't
# redirect back to localhost. Local Gmail OAuth flow is a known v1
# limitation; see README "Known limitations".
GMAIL_OAUTH_REDIRECT_URI=https://claimit-api-gateway-i4zxjn67hq-ue.a.run.app/api/v1/gmail/callback
ASSISTANT_AGENT_URL=https://claimit-assistant-agent-i4zxjn67hq-ue.a.run.app
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/claimitbeta
PHOENIX_PROJECT_NAME=claimit
