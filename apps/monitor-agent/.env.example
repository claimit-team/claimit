# Populate apps/monitor-agent/.env.local via:
#     ./scripts/fetch_env.sh monitor-agent
#
# Mirrors `local.monitor_secrets` + `module "monitor_agent"` in
# infra/terraform/main.tf. Note monitor-agent has no env_vars block in
# Terraform; static values below are derived from code defaults.

# ---- Secret Manager values ----
MONGODB_URI=
KEEPA_API_KEY=
SCRAPERAPI_KEY=

# ---- Static ----
GCP_PROJECT_ID=claimit-beta
GOOGLE_CLOUD_PROJECT=claimit-beta
GOOGLE_CLOUD_LOCATION=us-east1
EVIDENCE_BUCKET=claimit-beta-evidence
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/claimitbeta
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/claimitbeta/v1/traces
PHOENIX_PROJECT_NAME=claimit

# Optional knobs (defaults shown).
# PRICE_SOURCE_MODE=mixed
# PRICE_SOURCE_OVERRIDES=
