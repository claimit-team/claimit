# Populate apps/sync-worker/.env.local via:
#     ./scripts/fetch_env.sh sync-worker
#
# Mirrors `local.sync_worker_secrets` in infra/terraform/main.tf.

# ---- Secret Manager values ----
MONGODB_URI=
ELASTIC_URL=
ELASTIC_API_KEY=

# ---- Static ----
MONGODB_DB=claimit
GCP_PROJECT_ID=claimit-beta
GOOGLE_CLOUD_PROJECT=claimit-beta
