# syntax=docker/dockerfile:1.7
# Shared Dockerfile for stateless FastAPI agents (ingest, claim, assistant).
# monitor-agent uses its own Dockerfile because it needs Playwright + Chromium.
#
# Build context: repo root.
#   docker build -f apps/Dockerfile.agent --build-arg APP_NAME=ingest-agent .
#   docker build -f apps/Dockerfile.agent --build-arg APP_NAME=claim-agent .
#   docker build -f apps/Dockerfile.agent --build-arg APP_NAME=assistant-agent .

ARG APP_NAME

# ---------- builder ----------
FROM python:3.12-slim AS builder
ARG APP_NAME

# Pin uv to the version used in CI (.github/workflows/ci.yml).
COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /usr/local/bin/uv

ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# Copy lock + manifest first so the deps layer caches separately from source.
# claimit-observability is a path dep (../../packages/shared/observability),
# so it must be present at /packages/... before `uv sync`.
COPY apps/${APP_NAME}/pyproject.toml apps/${APP_NAME}/uv.lock ./
COPY packages/shared/observability /packages/shared/observability
COPY packages/shared/mcp /packages/shared/mcp
RUN uv sync --frozen --no-dev --no-install-project

# Now copy source and install the project itself.
COPY apps/${APP_NAME}/src ./src
RUN uv sync --frozen --no-dev

# ---------- runtime ----------
FROM python:3.12-slim

RUN groupadd --system app && \
    useradd --system --gid app --home /app --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=builder --chown=app:app /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER app
EXPOSE 8080

# Shell form so Cloud Run's injected $PORT expands at runtime.
CMD exec uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8080}
