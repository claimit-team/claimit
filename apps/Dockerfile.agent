# syntax=docker/dockerfile:1.7
# Shared Dockerfile for stateless FastAPI agents (ingest, claim, assistant)
# and the sync worker (long-running MongoDB → Elasticsearch change-stream tailer).
# monitor-agent uses its own Dockerfile because it needs Playwright + Chromium.
#
# Build context: repo root.
#   docker build -f apps/Dockerfile.agent --build-arg APP_NAME=ingest-agent .
#   docker build -f apps/Dockerfile.agent --build-arg APP_NAME=claim-agent .
#   docker build -f apps/Dockerfile.agent --build-arg APP_NAME=assistant-agent .
#   docker build -f apps/Dockerfile.agent --build-arg APP_NAME=sync-worker .
#
# Why we mirror the monorepo layout at /build/ inside the container:
# uv.lock pins shared packages as `directory = "../../packages/shared/<name>"`,
# resolved relative to each agent's pyproject.toml. With WORKDIR /app, uv
# rejects `/app/../../packages/...` as escaping the project root. Placing the
# agent at /build/apps/<APP_NAME>/ and the shared packages at
# /build/packages/shared/<name>/ makes the `../../` traversal resolve cleanly.

ARG APP_NAME

# Stage source for uv binary (pinned to the version used in CI).
FROM ghcr.io/astral-sh/uv:0.11.14 AS uv

# ---------- builder ----------
FROM python:3.12-slim AS builder
ARG APP_NAME

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

# Mirror monorepo structure so ../../packages/shared/... resolves correctly.
WORKDIR /build/apps/${APP_NAME}

# Copy lock + manifest first so the deps layer caches separately from source.
COPY apps/${APP_NAME}/pyproject.toml apps/${APP_NAME}/uv.lock ./

# Shared packages at their monorepo-relative positions.
COPY packages/shared/observability /build/packages/shared/observability
COPY packages/shared/mcp /build/packages/shared/mcp
COPY packages/shared/mongodb /build/packages/shared/mongodb
COPY packages/shared/pubsub /build/packages/shared/pubsub
COPY packages/shared/elastic /build/packages/shared/elastic
COPY packages/shared/search /build/packages/shared/search
COPY packages/shared/maps /build/packages/shared/maps
COPY packages/shared/gmail /build/packages/shared/gmail
COPY packages/shared/notifier /build/packages/shared/notifier

# Install deps (../../packages/shared/... now resolves to /build/packages/shared/...).
RUN uv sync --frozen --no-dev --no-install-project

# Copy app source and install the project itself.
COPY apps/${APP_NAME}/src ./src
RUN uv sync --frozen --no-dev

# ---------- runtime ----------
FROM python:3.12-slim AS runtime
ARG APP_NAME

RUN groupadd --system app && \
    useradd --system --gid app --home /app --shell /usr/sbin/nologin app

WORKDIR /app

COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --from=builder --chown=app:app /build/apps/${APP_NAME}/src /app/src

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER app
EXPOSE 8080

# Shell form so Cloud Run's injected $PORT expands at runtime.
CMD exec uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8080}
