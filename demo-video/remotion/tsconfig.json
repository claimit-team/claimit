{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": true,
    "paths": {
      "@/*": ["../../apps/web/src/*"],
      "@local/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "remotion.config.ts"],
  "exclude": ["src/_legacy/**", "node_modules"]
}
